PORT=3000
SESSION_SECRET=change-me-before-you-demo

# Demo account passwords used by `npm run seed`. Local defaults: admin123 / user123.
# DEMO_ADMIN_PASSWORD=
# DEMO_USER_PASSWORD=

# Cloud Postgres (Neon / Supabase). If set, it wins over the PG* vars below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local Postgres fallback
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=jobtrack
# PGUSER=postgres
# PGPASSWORD=
