  </div>
</div>

<% if (typeof tabbar === 'undefined' || tabbar) { %>
<nav class="tabbar d-lg-none">
  <a class="tab <%= active === 'dashboard' ? 'is-active' : '' %>" href="/">
    <svg class="ic"><use href="#i-grid" /></svg>
    <span>看板</span>
  </a>
  <a class="tab" href="/?modal=1&mode=new" aria-label="新增投递">
    <span class="tab-fab"><svg class="ic"><use href="#i-plus" /></svg></span>
  </a>
  <% if (user.can_manage_users) { %>
  <a class="tab <%= active === 'admin' ? 'is-active' : '' %>" href="/admin/users">
    <svg class="ic"><use href="#i-user" /></svg>
    <span>我的</span>
  </a>
  <% } %>
</nav>
<% } %>

</body>
</html>
