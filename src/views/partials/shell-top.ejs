<%- include('head', { title: title }) %>
<%- include('icons') %>

<aside class="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark"><svg class="ic"><use href="#i-briefcase" /></svg></span>
    <span>
      <span class="brand-name">JobTrack</span><br />
      <span class="brand-sub">求职投递追踪</span>
    </span>
  </a>

  <div class="nav-section">工作台</div>

  <a class="nav-item <%= active === 'dashboard' ? 'is-active' : '' %>" href="/">
    <svg class="ic"><use href="#i-grid" /></svg>
    投递看板
  </a>
  <% if (user.can_manage_users) { %>
  <a class="nav-item <%= active === 'admin' ? 'is-active' : '' %>" href="/admin/users">
    <svg class="ic"><use href="#i-users" /></svg>
    用户与权限
    <span class="nav-badge">Admin</span>
  </a>
  <% } %>

  <div class="sidebar-foot">
    <div class="side-user">
      <span class="avatar"><%= user.initial %></span>
      <span>
        <span class="side-user-name"><%= user.username %></span><br />
        <span class="side-user-role"><%= user.role === 'admin' ? '管理员' : '普通用户' %></span>
      </span>
      <button class="icon-btn theme-toggle" type="button" title="切换主题" aria-label="切换主题">
        <svg class="ic ic-sun"><use href="#i-sun" /></svg>
        <svg class="ic ic-moon"><use href="#i-moon" /></svg>
      </button>
      </button>
      <form class="logout-form" method="post" action="/logout" style="margin-left:auto">
        <button class="icon-btn" type="submit" title="登出" aria-label="登出">
          <svg class="ic"><use href="#i-logout" /></svg>
        </button>
      </form>
    </div>
  </div>
</aside>

<div class="shell">
  <main class="page">
    <div class="mobile-head d-lg-none">
      <a class="brand" href="/">
        <span class="brand-mark"><svg class="ic"><use href="#i-briefcase" /></svg></span>
        <span class="brand-name">JobTrack</span>
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label="切换主题">
        <svg class="ic ic-sun"><use href="#i-sun" /></svg>
        <svg class="ic ic-moon"><use href="#i-moon" /></svg>
      </button>
      <div style="display:flex;align-items:center;gap:0.5rem">
        <span class="avatar"><%= user.initial %></span>
        <form class="logout-form" method="post" action="/logout">
          <button class="icon-btn" type="submit" title="登出" aria-label="登出">
            <svg class="ic"><use href="#i-logout" /></svg>
          </button>
        </form>
      </div>
    </div>
