<%- include('partials/head', { title: '登录' }) %>
<%- include('partials/icons') %>

<div class="login">
  <section class="login-brand">
    <a class="brand" href="/login">
      <span class="brand-mark"><svg class="ic"><use href="#i-briefcase" /></svg></span>
      <span>
        <span class="brand-name">JobTrack</span><br />
        <span class="brand-sub">求职投递追踪</span>
      </span>
    </a>

    <div class="login-pitch">
      <h1>把每一次投递，<br />都<em>跟到底</em>。</h1>
      <p>从投递、面试到 Offer —— 一张看板看清全部进度，不再靠备忘录和邮箱翻记录。</p>
    </div>

    <div class="login-stats">
      <div class="login-stat"><b>12</b><span>条投递</span></div>
      <div class="login-stat"><b>3</b><span>个面试机会</span></div>
      <div class="login-stat"><b>2</b><span>个 Offer</span></div>
    </div>

    <div class="login-copy">© 2026 JobTrack · ERB DS280 小组项目</div>
  </section>

  <section class="login-panel">
    <form class="login-form" method="post" action="/login">
      <h2>欢迎回来</h2>
      <p class="lead">登录后继续管理你的求职进度。</p>

      <% if (error) { %>
      <div class="alert-error" role="alert">
        <svg class="ic"><use href="#i-alert" /></svg>
        用户名或密码不正确
      </div>
      <% } %>

      <div class="field">
        <label for="login-username">用户名</label>
        <div class="control has-icon">
          <svg class="ic"><use href="#i-user" /></svg>
          <input id="login-username" name="username" autocomplete="username" required placeholder="输入用户名" />
        </div>
      </div>

      <div class="field">
        <label for="login-password">密码</label>
        <div class="control has-icon">
          <svg class="ic"><use href="#i-lock" /></svg>
          <input id="login-password" name="password" type="password" autocomplete="current-password" required placeholder="输入密码" />
        </div>
      </div>

      <button class="btn-jt btn-jt-block" type="submit" style="height: 44px">登录</button>

      <div class="login-hint">
        <div class="title">演示账号</div>
        <div class="accounts">
          <button class="account-chip" type="button" data-username="admin" data-password="admin123">
            <b>admin</b> · 管理员
          </button>
          <button class="account-chip" type="button" data-username="alice" data-password="user123">
            <b>alice</b> · 普通用户
          </button>
        </div>
      </div>

      <p class="login-foot">还没有账号？请联系管理员开通。</p>
    </form>
  </section>
</div>

<script>
  // Demo chips fill the form — the accounts exist only in the seeded database.
  document.querySelectorAll(".account-chip").forEach(function (chip) {
    chip.addEventListener("click", function () {
      document.getElementById("login-username").value = chip.dataset.username;
      document.getElementById("login-password").value = chip.dataset.password;
      document.getElementById("login-username").focus();
    });
  });
</script>

</body>
</html>
