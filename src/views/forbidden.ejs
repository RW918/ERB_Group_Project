    <a class="btn-jt" href="/" autofocus>返回看板</a>
  </div>
</dialog>

<script>document.getElementById("forbidden-dialog").showModal();</script>
<noscript>
  <div class="page">
    <div class="alert-error" role="alert">没有权限 —— 这个页面只对有「管理用户」权限的账号开放。</div>
  </div>
</noscript>

