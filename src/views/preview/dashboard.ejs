<%- include('partials/shell-top', { title: '投递看板', active: 'dashboard', user: user }) %>

<div class="page-head">
  <div>
    <div class="eyebrow">2026 秋招 · 第 12 周</div>
    <h1 class="page-title">投递看板</h1>
    <p class="page-sub">共 <%= counts.total %> 条投递 · <%= counts.interviewing %> 个面试机会 · <%= counts.offer %> 个 Offer</p>
  </div>
  <div class="page-actions">
    <label class="search">
      <svg class="ic"><use href="#i-search" /></svg>
      <input type="search" placeholder="搜索公司或职位" aria-label="搜索" />
    </label>
    <a class="btn-jt" href="/preview/dashboard?modal=1&mode=new">
      <svg class="ic"><use href="#i-plus" /></svg>
      新增投递
    </a>
  </div>
</div>

<div class="kpi-grid">
  <div class="kpi">
    <div class="kpi-top">
      <span class="kpi-label">总投递</span>
      <span class="kpi-icon"><svg class="ic"><use href="#i-briefcase" /></svg></span>
    </div>
    <div class="kpi-value"><%= counts.total %></div>
    <div class="kpi-foot">
      <span class="kpi-delta"><svg class="ic"><use href="#i-trend" /></svg>+3</span>
      本周新增
    </div>
  </div>
  <div class="kpi kpi--warn">
    <div class="kpi-top">
      <span class="kpi-label">面试机会</span>
      <span class="kpi-icon"><svg class="ic"><use href="#i-calendar" /></svg></span>
    </div>
    <div class="kpi-value"><%= counts.interviewing %></div>
    <div class="kpi-foot">最近一场 11 月 30 日</div>
  </div>
  <div class="kpi kpi--ok">
    <div class="kpi-top">
      <span class="kpi-label">Offer</span>
      <span class="kpi-icon"><svg class="ic"><use href="#i-check" /></svg></span>
    </div>
    <div class="kpi-value"><%= counts.offer %></div>
    <div class="kpi-foot">转化率 16.7%</div>
  </div>
  <div class="kpi kpi--bad">
    <div class="kpi-top">
      <span class="kpi-label">已拒绝</span>
      <span class="kpi-icon"><svg class="ic"><use href="#i-x" /></svg></span>
    </div>
    <div class="kpi-value"><%= counts.rejected %></div>
    <div class="kpi-foot">较上月少 1 条</div>
  </div>
</div>

<div class="toolbar">
  <div class="chips">
    <span class="chip is-active">全部 <b><%= counts.total %></b></span>
    <span class="chip">已投递 <b><%= counts.applied %></b></span>
    <span class="chip">面试机会 <b><%= counts.interviewing %></b></span>
    <span class="chip">Offer <b><%= counts.offer %></b></span>
    <span class="chip">已拒绝 <b><%= counts.rejected %></b></span>
  </div>
  <button class="sort" type="button">
    最近更新
    <svg class="ic"><use href="#i-chevron" /></svg>
  </button>
</div>

<div class="app-grid">
  <% apps.forEach(function (a) { %>
  <article class="app-card">
    <div class="app-top">
      <span class="logo-tile" style="background: <%= a.tint %>; color: <%= a.tintInk %>"><%= a.initial %></span>
      <div style="min-width: 0">
        <h3 class="app-company"><%= a.company %></h3>
        <a class="app-role" href="<%= a.url %>">
          <%= a.role %>
          <svg class="ic"><use href="#i-arrow-ur" /></svg>
        </a>
      </div>
      <span class="status <%= a.statusClass %>"><%= a.statusLabel %></span>
    </div>

    <div class="app-divider"></div>

    <ul class="meta">
      <li>
        <svg class="ic"><use href="#i-pin" /></svg>
        <span class="clip"><%= a.location %></span>
      </li>
      <li>
        <svg class="ic"><use href="#i-wallet" /></svg>
        <span class="clip"><%= a.salary %></span>
      </li>
      <li>
        <svg class="ic"><use href="#i-clock" /></svg>
        <span>截止 <%= a.deadlineLabel %></span>
        <% if (a.daysLeft !== null) { %>
        <span class="days"><%= a.daysLeft >= 0 ? '剩 ' + a.daysLeft + ' 天' : '已截止' %></span>
        <% } %>
      </li>
    </ul>

    <div class="app-foot">
      <span class="interview-chip">
        <svg class="ic"><use href="#i-calendar" /></svg>
        <%= a.interview ? '面试 ' + a.interviewLabel : '面试待安排' %>
      </span>
      <div class="row-actions">
        <a class="icon-btn" href="/preview/dashboard?modal=1" title="编辑" aria-label="编辑">
          <svg class="ic"><use href="#i-edit" /></svg>
        </a>
        <button class="icon-btn danger" type="button" title="删除" aria-label="删除">
          <svg class="ic"><use href="#i-trash" /></svg>
        </button>
      </div>
    </div>
  </article>
  <% }); %>
</div>

<% if (modal) { %>
<div class="overlay" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-head">
      <div>
        <h2><%= editing ? '编辑投递' : '新增投递' %></h2>
        <p><%= editing ? m.company + ' · ' + m.role : '记录一条新的求职投递' %></p>
      </div>
      <a class="icon-btn" href="/preview/dashboard" aria-label="关闭">
        <svg class="ic"><use href="#i-x" /></svg>
      </a>
    </div>

    <form method="post" action="#">
      <div class="modal-body">
        <div class="field">
          <label for="f-company">公司名称 <span class="req">*</span></label>
          <div class="control">
            <input id="f-company" name="company" value="<%= editing ? m.company : '' %>" placeholder="例如：Example Ltd" />
          </div>
        </div>
        <div class="field">
          <label for="f-role">职位名称 <span class="req">*</span></label>
          <div class="control">
            <input id="f-role" name="position" value="<%= editing ? m.role : '' %>" placeholder="例如：Junior Developer" />
          </div>
        </div>

        <div class="field">
          <label for="f-status">状态</label>
          <div class="control">
            <select id="f-status" name="status">
              <option value="applied">已投递</option>
              <option value="interviewing" <%= editing && m.status === 'interviewing' ? 'selected' : '' %>>面试机会</option>
              <option value="offer" <%= editing && m.status === 'offer' ? 'selected' : '' %>>Offer</option>
              <option value="rejected" <%= editing && m.status === 'rejected' ? 'selected' : '' %>>已拒绝</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="f-interview">面试日期</label>
          <div class="control">
            <input id="f-interview" name="interview_date" type="date" value="<%= editing && m.interviewDate ? m.interviewDate : '' %>" />
          </div>
        </div>

        <div class="field">
          <label for="f-location">地点</label>
          <div class="control">
            <input id="f-location" name="location" value="<%= editing ? m.location : '' %>" placeholder="例如：香港 · 混合办公" />
          </div>
        </div>
        <div class="field">
          <label for="f-deadline">截止日期</label>
          <div class="control">
            <input id="f-deadline" name="deadline" type="date" value="<%= editing && m.deadlineRaw ? m.deadlineRaw : '' %>" />
          </div>
        </div>

        <div class="field">
          <label for="f-salary">薪资范围</label>
          <div class="control">
            <input id="f-salary" name="salary" value="<%= editing ? m.salary : '' %>" placeholder="例如：HKD 20k–25k / 月" />
          </div>
        </div>
        <div class="field">
          <label for="f-url">投递链接</label>
          <div class="control">
            <input id="f-url" name="posting_url" value="<%= editing ? m.url : '' %>" placeholder="https://" />
          </div>
        </div>

        <div class="field span-2">
          <label for="f-note">备注</label>
          <div class="control">
            <textarea id="f-note" name="note" placeholder="面试轮次、联系人、准备事项……"><%= editing ? m.note : '' %></textarea>
          </div>
        </div>
      </div>

      <div class="modal-foot">
        <a class="btn-jt btn-jt-ghost" href="/preview/dashboard">取消</a>
        <button class="btn-jt" type="submit">
          <svg class="ic"><use href="#i-check" /></svg>
          <%= editing ? '保存修改' : '保存投递' %>
        </button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include('partials/shell-bottom', { active: 'dashboard' }) %>
