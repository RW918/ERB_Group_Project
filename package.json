{
  "name": "ds280-project",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc && rm -rf dist/views && cp -r src/views dist/views",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js migrate:rollback",
    "seed": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js seed:run",
    "seed:make": "knex seed:make",
    "vendor": "mkdir -p public/vendor && cp node_modules/bootstrap/dist/css/bootstrap.min.css node_modules/bootstrap/dist/js/bootstrap.bundle.min.js public/vendor/",
    "postinstall": "npm run vendor",
    "prepare": "git config core.hooksPath .githooks",
    "erd": "mermaid-erd-cli --schema draft/erd.sql --format mermaid --out draft/erd.generated.mmd && mmdc -i draft/erd.generated.mmd -o draft/JobTrack_ERD_P3.png -b white -s 2"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "mermaid-erd-cli": "^0.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
